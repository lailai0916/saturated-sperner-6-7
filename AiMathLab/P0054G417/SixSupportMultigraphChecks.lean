    (values : List Nat)
    (hLength : values.length = 2)
    (hValues : ∀ k ∈ values, k < 4) :
    sixSupportMultigraphEarlyValuesAdmissible 4 15 values
      sixSupportOrder4 sixCompletionGroups4
      0 sixCompactDegreesZero 0 = true →
