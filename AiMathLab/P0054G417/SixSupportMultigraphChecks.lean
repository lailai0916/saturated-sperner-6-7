  · simp at hLength
  cases values with
  | cons extra values => simp at hLength
  | nil =>
      exact six_support_multigraph_early_prefix_check_4
        ⟨k0, hValues k0 (by simp)⟩ ⟨k1, hValues k1 (by simp)⟩
        hAdmissible
